{
  "schema": "vgame-knowledge-retrieval-policy/v1",
  "version": "1.0",
  "updatedAt": "2026-08-17",
  "promptlessRouting": true,
  "contractRegistryRef": "shared-contracts/contract-registry.json",
  "principles": [
    "知识库在存储层保持完整，在单次调用中只加载最小相关知识包。",
    "先读轻量路由清单，再按问题升级到系统正文、共享契约和原始证据。",
    "同一事实只保留一个正文权威入口，关系只存稳定ID与差异，不复制目标系统全文。",
    "工作副本、目标设计、跨源归纳和Production/LIVE必须分开标识。"
  ],
  "layers": [
    {
      "id": "L0",
      "name": "项目总览",
      "purpose": "回答项目定位、核心循环和系统/战斗/数值总体框架。",
      "defaultRefs": ["00-项目总览.md"]
    },
    {
      "id": "L1",
      "name": "目录与关系索引",
      "purpose": "定位系统、模块、摘要、别名、关系和正文入口。",
      "defaultRefs": ["router-manifest.json", "knowledge-model.json"]
    },
    {
      "id": "L2",
      "name": "系统正文与共享契约",
      "purpose": "回答规则、流程、条件、奖励、异常、UI、关系和跨系统影响。",
      "defaultRefs": ["system-details/<SYSTEM_ID>.json", "shared-contracts/contract-registry.json"]
    },
    {
      "id": "L3",
      "name": "原始证据",
      "purpose": "核验具体数值、字段、配置、代码、Design原文和运行状态。",
      "defaultRefs": ["系统正文中的 evidence.path"]
    }
  ],
  "depthProfiles": {
    "quick": {
      "description": "项目介绍、有哪些系统、系统属于哪类。",
      "layers": ["L0", "L1"],
      "maxSystemDetails": 0,
      "maxContracts": 0,
      "maxEvidenceFiles": 0
    },
    "design": {
      "description": "系统如何运行、系统关系、规则审查和改动影响。",
      "layers": ["L1", "L2"],
      "maxSystemDetails": 3,
      "maxContracts": 5,
      "maxEvidenceFiles": 0
    },
    "audit": {
      "description": "精确字段、数值、配置、源码、证据和LIVE核验。",
      "layers": ["L1", "L2", "L3"],
      "maxSystemDetails": 3,
      "maxContracts": 5,
      "maxEvidenceFiles": 5
    }
  },
  "intentSignals": {
    "quick": ["是什么", "有哪些", "概览", "框架", "分类", "属于什么", "简单介绍"],
    "design": ["规则", "流程", "怎么运作", "关系", "影响", "策划案", "设计", "异常", "奖励类型", "条件", "UI", "资格", "门槛", "胜负", "触发", "结算"],
    "audit": ["具体数值", "多少", "字段", "Excel", "配置", "代码", "源码", "证据", "真实", "当前", "上线", "LIVE", "Drop", "Unlock", "SystemOpen", "核验"]
  },
  "provenance": [
    {"id": "SOURCE_EXPLICIT", "name": "原文明确", "meaning": "Design、数值沉淀或其他权威文本直接说明。"},
    {"id": "WORKING_COPY_OBSERVED", "name": "配置观察", "meaning": "本机SVN工作副本只读观察，不证明Production/LIVE。"},
    {"id": "CROSS_SOURCE_SYNTHESIS", "name": "跨源归纳", "meaning": "由多份证据组织出的关系、流程或边界，需要项目负责人确认。"},
    {"id": "DESIGN_PROPOSAL", "name": "候选设计", "meaning": "为补齐缺口提出的方案，不是项目既有事实。"},
    {"id": "UNKNOWN", "name": "待确认", "meaning": "证据不足或相互冲突，不能代答。"}
  ],
